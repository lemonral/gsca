# Copy to .env and adjust paths. Store token values in files, not in this file.
# Linux rootful Docker: use the host account UID/GID for writable bind mounts.
AGENT_UID=1000
AGENT_GID=1000
APP_BIND_HOST=127.0.0.1
APP_PORT=3189
AGENT_DATA_DIR=./data

# Existing authenticated Ollama proxy; no additional model is downloaded.
MODEL_BASE_URL=http://127.0.0.1:3184
MODEL_NAME=qwen3.8:27b
MODEL_TOKEN_FILE=/absolute/path/to/existing-model-proxy-token

# A different, app-only login code. Never point this at the model token file.
APP_ACCESS_TOKEN_FILE=/absolute/path/to/general-agent/data/access-token
AGENT_MAX_STEPS=8
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_TOTAL_TOKENS=18000
AGENT_RUN_TIMEOUT=240
